{
  "packageManager": "pnpm@11.21.0",
  "private": true,
  "name": "blemeshjs",
  "version": "1.0.0",
  "description": "TypeScript BLE Mesh monorepo for shared utilities, core layers, and SDK packages.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build --filter=@blemeshjs/utils --filter=@blemeshjs/crypto --filter=@blemeshjs/core --filter=@blemeshjs/sdk --filter=@blemeshjs/sdk-web --filter=@blemeshjs/sdk-react-native",
    "lint": "turbo run lint --filter=!./apps/mobile --filter=!./apps/docs --filter=!./apps/web",
    "format": "turbo run format --filter=!./apps/mobile --filter=!./apps/docs",
    "clean": "turbo run clean",
    "test": "vitest run",
    "coverage": "vitest --ui --coverage",
    "release:test": "turbo run test --filter=@blemeshjs/utils --filter=@blemeshjs/crypto --filter=@blemeshjs/core --filter=@blemeshjs/sdk --filter=@blemeshjs/sdk-web --filter=@blemeshjs/sdk-react-native",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "node ./scripts/publish-public-packages.mjs",
    "release:publish:dry-run": "node ./scripts/publish-public-packages.mjs --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
