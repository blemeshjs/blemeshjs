# Expo/React Native (apps/mobile) resolves native modules through a flat tree;
# isolated symlinks break Metro and autolinking, so keep the hoisted layout.
node-linker=hoisted

# Match the Yarn behaviour this repo migrated from.
link-workspace-packages=true

# apps/docs drives API-doc regeneration through prebuild/predev/pretypes:check;
# pnpm ignores pre/post hooks on custom scripts without this.
enable-pre-post-scripts=true
