{
  "name": "@blemeshjs/core",
  "version": "0.0.1",
  "description": "Core BLE Mesh bearer, provisioning, message, and lower-layer primitives.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blemeshjs/blemeshjs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/blemeshjs/blemeshjs/issues"
  },
