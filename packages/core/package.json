  },
  "dependencies": {
    "@blemeshjs/crypto": "workspace:^",
    "@blemeshjs/utils": "workspace:^",
    "@borewit/text-codec": "^0.2.1",
    "async-mutex": "^0.5.0",
    "immer": "^11.1.4",
    "long": "^5.3.2",
    "lru-cache": "^11.1.0",
    "mobx": "^6.15.0",
