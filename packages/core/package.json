{
  "name": "@blemeshjs/core",
  "packageManager": "yarn@4.9.2",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "coverage": "vitest --ui --coverage",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/lodash": "^4",
    "@types/node": "^24.1.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@blemeshjs/crypto": "workspace:^",
    "@blemeshjs/utils": "workspace:^",
    "@borewit/text-codec": "^0.2.1",
    "async-mutex": "^0.5.0",
    "immer": "^11.1.4",
    "lodash": "^4.17.21",
    "long": "^5.3.2",
    "lru-cache": "^11.1.0",
    "mobx": "^6.15.0",
    "serializr": "^3.0.5",
    "ts-mixer": "^6.0.4",
    "uint8array-extras": "^1.5.0",
    "zod": "^4.3.6"
  }
