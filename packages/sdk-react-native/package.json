{
  "name": "@blemeshjs/sdk-react-native",
  "version": "0.0.1",
  "description": "React Native transport and storage bindings for the blemeshjs SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blemeshjs/blemeshjs.git",
    "directory": "packages/sdk-react-native"
  },
  "bugs": {
    "url": "https://github.com/blemeshjs/blemeshjs/issues"
  },
  "homepage": "https://github.com/blemeshjs/blemeshjs/tree/main/packages/sdk-react-native#readme",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "test": "vitest run",
    "coverage": "vitest --ui --coverage"
  },
  "dependencies": {
    "@blemeshjs/sdk": "workspace:^",
    "@blemeshjs/utils": "workspace:^",
    "long": "^5.3.2",
    "uint8array-extras": "^1.5.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "react-native": "~0.74.1",
    "react-native-ble-plx": "~3.5.0",
    "react-native-get-random-values": "~1.11.0"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@types/node": "^24.1.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "react-native-ble-plx": "^3.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
