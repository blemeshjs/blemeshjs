{
  "name": "@blemeshjs/crypto",
  "version": "0.0.1",
  "description": "BLE Mesh cryptographic helpers built on top of @blemeshjs/utils.",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.11.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "coverage": "vitest --ui --coverage",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@blemeshjs/utils": "workspace:^",
    "long": "^5.3.2",
    "uint8array-extras": "^1.5.0"
  }
}
