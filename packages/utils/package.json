{
  "name": "@blemeshjs/utils",
  "version": "0.0.1",
  "description": "Shared BLE Mesh enums, helpers, messages, models, and low-level utilities.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blemeshjs/blemeshjs.git",
