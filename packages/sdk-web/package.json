{
  "name": "@blemeshjs/sdk-web",
  "version": "0.0.1",
  "description": "Web transport and browser storage bindings for the blemeshjs SDK.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blemeshjs/blemeshjs.git",
    "directory": "packages/sdk-web"
  },
  "bugs": {
    "url": "https://github.com/blemeshjs/blemeshjs/issues"
  },
  "homepage": "https://github.com/blemeshjs/blemeshjs/tree/main/packages/sdk-web#readme",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "coverage": "vitest --ui --coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "@blemeshjs/crypto": "workspace:^",
    "@blemeshjs/sdk": "workspace:^",
    "long": "^5.3.2",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
