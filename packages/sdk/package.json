{
  "name": "@mesh-link-js/sdk",
  "version": "0.0.1",
  "packageManager": "yarn@4.9.2",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "test": "vitest run",
    "coverage": "vitest --ui --coverage"
  },
  "dependencies": {
    "@mesh-link-js/core": "workspace:^",
    "@mesh-link-js/utils": "workspace:^",
    "long": "^5.3.2",
    "mobx": "^6.15.0",
    "ts-mixer": "^6.0.4",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
