{
  "name": "@blemeshjs/sdk",
  "version": "0.0.1",
  "description": "High-level BLE Mesh SDK with network management, models, and extensions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blemeshjs/blemeshjs.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/blemeshjs/blemeshjs/issues"
  },
  "homepage": "https://github.com/blemeshjs/blemeshjs/tree/main/packages/sdk#readme",
  "packageManager": "yarn@4.9.2",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --ui --coverage",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "lint": "eslint --config ./eslint.config.mjs . --fix",
    "lint:check": "eslint --config ./eslint.config.mjs .",
    "test": "vitest run"
  },
  "dependencies": {
    "@blemeshjs/core": "workspace:^",
    "@blemeshjs/utils": "workspace:^",
    "long": "^5.3.2",
    "mobx": "^6.15.0",
    "ts-mixer": "^6.0.4",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
